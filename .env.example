# PostgreSQL（例: ローカル）
# createdb book_impression などで DB を作成してから接続文字列を合わせてください
DATABASE_URL="postgresql://appuser:1234@localhost:5432/book_impression?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Checkout の success/cancel URL のオリジン（LAN 越しなら例: http://192.168.1.37:3000）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe（テストキーは .env のみ。Git に含めない）
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# 月額サブスクリプションの Price ID（Stripe ダッシュボード → 商品 → 価格、例: price_xxxx）
STRIPE_PRICE_ID=

# Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook の whsec_...
STRIPE_WEBHOOK_SECRET=

# true なら /pricing の Checkout を無効化し POST /api/stripe/checkout は 403（テスト段階で課金を止める）
# DISABLE_STRIPE_CHECKOUT=true

# 任意: 本番ビルドでもデモ／テストユーザーの感想を誰でも編集・削除可能にする（通常は使わない）
# ALLOW_EDIT_SEED_REVIEWS=true

# 任意: Stripe なしで投稿・映画追加を試す（本番では true にしない）
# DISABLE_PAID_GATING=true
